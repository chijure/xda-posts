[TR][TD]0xec5e[/TD][TD]0x80116c5e[/TD][TD]88 b1[/TD][TD]11 e0[/TD][TD]CBZ R0 → B (verification wrapper)[/TD][/TR]
[TR][TD]0x125e4[/TD][TD]0x8011a5e4[/TD][TD]1b d0[/TD][TD]1b e0[/TD][TD]BEQ → B (generic verification)[/TD][/TR]
[/TABLE]

