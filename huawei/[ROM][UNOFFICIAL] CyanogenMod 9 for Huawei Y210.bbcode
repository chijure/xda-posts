[SIZE="4"][B]Useful validation commands:[/B][/SIZE]
[CODE]adb logcat
adb shell dumpsys SurfaceFlinger | grep -i -E "renderer|h/w composer"
adb shell dumpsys wifi | sed -n '1,20p'
adb shell getprop wlan.driver.status
adb shell getprop gsm.sim.state
adb shell getprop gsm.version.baseband
adb shell dumpsys connectivity | grep -A3 "Tether state"[/CODE]

